# URL of the Kast Express backend. This is an app URL, not a third-party API key.
# Create frontend/.env from this file. React only exposes variables beginning
# with REACT_APP_ to browser code. Restart `npm start` after changing it.
REACT_APP_API_URL=http://localhost:5001

# Optional: Create React App's development port (defaults to 3000).
PORT=3000
