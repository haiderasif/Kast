JWT_SECRET=
# Firebase Admin credential downloaded from Firebase Console:
# Project settings -> Service accounts -> Firebase Admin SDK -> Generate new private key.
# Keep this JSON private and never commit it.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Local server settings. Change both this port and frontend/.env's API URL together.
PORT=5001
FRONTEND_ORIGIN=http://localhost:3000

# Firebase Web API key used by the backend to verify email/password login.
# Firebase Console -> Project settings -> General -> Your apps -> Web app config.
FIREBASE_WEB_API_KEY=

FIREBASE_DATABASE_URL=

