# Required: secret used to sign this app's own login tokens.
# This is not obtained from an API provider. Generate a strong random value with:
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_random_secret

# Required: path to a Firebase Admin service-account JSON file, relative to
# this backend directory (an absolute path also works).
# Get it from Firebase Console:
#   Project settings -> Service accounts -> Firebase Admin SDK
#   -> Generate new private key
# Save the downloaded JSON inside backend/ without committing it, then put its
# filename here. Firebase Authentication must also be enabled in the console:
#   Build -> Authentication -> Get started -> Sign-in method -> Email/Password
FIREBASE_SERVICE_ACCOUNT_PATH=your-project-firebase-adminsdk.json

# Required for email/password login. This Firebase Web API key identifies your
# Firebase project (it is not the Admin private key). Find it in Firebase Console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup/config
# If no web app exists, click "Add app" and choose the web (</>) icon.
FIREBASE_WEB_API_KEY=replace_with_your_firebase_web_api_key

# Firebase Realtime Database URL. Find it in Firebase Console under
# Build -> Realtime Database. It appears at the top of the Data tab.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Optional. These defaults match the local frontend setup.
PORT=5001
FRONTEND_ORIGIN=http://localhost:3000
